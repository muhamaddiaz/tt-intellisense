{
  "name": "tt-intellisense",
  "displayName": "TT IntelliSense",
  "description": "Language support for Perl Template Toolkit: highlighting, navigation, diagnostics and variable completion.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tt",
        "aliases": [
          "Template Toolkit",
          "tt"
        ],
        "extensions": [
          ".tt",
          ".ttml",
          ".tt2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tt",
        "scopeName": "text.html.tt",
        "path": "./syntaxes/tt.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "scopeName": "text.html.tt.injection",
        "path": "./syntaxes/tt-injection.tmLanguage.json",
        "injectTo": [
          "text.html.tt"
        ]
      }
    ],
    "configuration": {
      "title": "TT IntelliSense",
      "properties": {
        "ttIntellisense.includePath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional directories searched when resolving `INCLUDE`, `PROCESS`, `INSERT` and `WRAPPER` targets, mirroring Template Toolkit's `INCLUDE_PATH`. Relative paths resolve against each workspace folder. The directory of the file containing the reference is always searched first."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test test/*.test.mjs",
    "pretest": "node test/fetch-grammars.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.1",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.14"
  },
  "activationEvents": [
    "onLanguage:tt"
  ],
  "publisher": "shareinvestor"
}
